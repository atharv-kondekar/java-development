
type OrderItem{
	id: ID!
	name: String!
	quantity: Int!
}

type Order{
	id: ID!
	total: Float!
	items: [OrderItem!]!
}

type User{
	id: ID!
	name: String!
	address: String!
	email: String!
	mobile: String
	orders:[Order!]!
}

type Query{
	user( id: ID! ) : User
	users: [User!]!
}

input UserInput{
	name:String!
	address: String!
	email: String!
	mobile: String!
}

type Mutation{
	createUser(input: UserInput!) : User
}
